<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CK Trading Bot</title>
  <style>
    body { background-color: #0b0f19; color: #ffffff; font-family: sans-serif; padding: 20px; text-align: center; }
    .card { background: #162032; padding: 20px; border-radius: 12px; max-width: 400px; margin: 0 auto; border: 1px solid #233248; }
    .btn-affiliate { display: block; background: #0284c7; color: #fff; padding: 12px; border-radius: 8px; text-decoration: none; font-weight: bold; margin: 15px 0; }
    .btn-trade { width: 48%; padding: 12px; border: none; border-radius: 8px; font-weight: bold; color: white; cursor: pointer; }
    .rise { background: #10b981; }
    .fall { background: #ef4444; }
    input, select { width: 100%; padding: 10px; margin: 8px 0 15px; border-radius: 6px; border: 1px solid #2c3d54; background: #0d1522; color: #fff; box-sizing: border-box; }
  </style>
</head>
<body>

  <div class="card">
    <h2 style="color: #38bdf8;">CK Trading Bot</h2>

    <div style="background: #0e1626; padding: 12px; border-radius: 8px; margin-bottom: 15px;">
      <small style="color: #94a3b8;">ACCOUNT BALANCE</small>
      <h3 id="bal" style="color: #38bdf8; margin: 5px 0;">--.--</h3>
    </div>

    <!-- Affiliate Banner -->
    <a href="https://t.deriv.link?t=JY62HWTRUYMQ" target="_blank" class="btn-affiliate">
      + Create Deriv Account (Get Started)
    </a>

    <label style="font-size: 12px; display: block; text-align: left;">Market</label>
    <select id="market">
      <option value="R_100">Volatility 100 Index</option>
      <option value="R_75">Volatility 75 Index</option>
      <option value="R_50">Volatility 50 Index</option>
    </select>

    <label style="font-size: 12px; display: block; text-align: left;">Trade Amount (USD)</label>
    <input type="number" id="stake" value="1">

    <div style="display: flex; justify-content: space-between;">
      <button class="btn-trade rise" onclick="trade('CALL')">Rise ↗</button>
      <button class="btn-trade fall" onclick="trade('PUT')">Fall ↘</button>
    </div>

    <p id="status" style="color: #fbbf24; font-size: 12px; margin-top: 15px;">Connecting...</p>
    <button onclick="setToken()" style="background: transparent; color: #38bdf8; border: none; font-size: 12px; text-decoration: underline; cursor: pointer; margin-top: 10px;">Set / Change API Token</button>
  </div>

  <script>
    const AFFILIATE_URL = "https://t.deriv.link?t=JY62HWTRUYMQ";
    let token = localStorage.getItem("deriv_token") || "";
    let ws = null;

    function init() {
      ws = new WebSocket("wss://ws.derivws.com/websockets/v3?app_id=1089");
      ws.onopen = () => {
        if(token) {
          document.getElementById("status").innerText = "Authorizing...";
          ws.send(JSON.stringify({ authorize: token }));
        } else {
          document.getElementById("status").innerText = "Token missing!";
          setToken();
        }
      };
      ws.onmessage = (e) => {
        const d = JSON.parse(e.data);
        if(d.msg_type === "authorize") {
          if(d.error) {
            alert("Token error: " + d.error.message);
            setToken();
          } else {
            document.getElementById("status").innerText = "Connected";
            ws.send(JSON.stringify({ balance: 1, subscribe: 1 }));
          }
        }
        if(d.msg_type === "balance" && d.balance) {
          document.getElementById("bal").innerText = d.balance.balance + " " + d.balance.currency;
        }
      };
    }

    function trade(type) {
      if(!ws || ws.readyState !== 1) return alert("Not connected");
      const market = document.getElementById("market").value;
      const stake = parseFloat(document.getElementById("stake").value) || 1;
      ws.send(JSON.stringify({
        buy: 1, price: stake,
        parameters: { amount: stake, basis: "stake", contract_type: type, currency: "USD", duration: 1, duration_unit: "t", symbol: market }
      }));
    }

    function setToken() {
      const t = prompt("Enter your Deriv API Token:", token);
      if(t) {
        token = t;
        localStorage.setItem("deriv_token", token);
        location.reload();
      }
    }

    window.onload = init;
  </script>
</body>
</html>
